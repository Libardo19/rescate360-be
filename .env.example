# Copiar a .env (cp .env.example .env) y completar. Nunca subir .env al repositorio.
# Los hosts "db" y "redis" son los nombres de los servicios de docker-compose.

# App
APP_ENV=local
API_PORT=8000

# PostgreSQL + PostGIS (lo usa el contenedor db).
# DB_PORT es el puerto expuesto en tu PC (5435: 5432-5434 los usan otros proyectos locales).
# Dentro de Docker la API siempre usa db:5432.
POSTGRES_USER=rescate
POSTGRES_PASSWORD=rescate
POSTGRES_DB=rescate360
DB_PORT=5435
DATABASE_URL=postgresql+psycopg2://rescate:rescate@db:5432/rescate360

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT (generar con: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=cambiar-en-local-por-una-clave-de-32-o-mas-caracteres
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=7

# Servicio de IA (clasificación de prioridad)
IA_API_KEY=

# Firebase (notificaciones push)
FIREBASE_CREDENTIALS_PATH=

# Twilio (SMS: respaldo del SOS y códigos de recuperación). Sin credenciales, el SMS solo queda en el log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Almacenamiento de fotos y videos. Sin bucket se guardan en UPLOADS_DIR y la API los sirve en /uploads
STORAGE_BUCKET=
UPLOADS_DIR=uploads
FOTO_MAX_MB=5
VIDEO_MAX_MB=30

# Retención de datos (días)
RETENCION_FOTOS_DIAS=90
RETENCION_UBICACIONES_DIAS=30

# pgAdmin (http://localhost:5050) — solo desarrollo local
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@rescate360.com
PGADMIN_PASSWORD=admin

# Altas por invitación: horas que dura el código de activación
ACTIVACION_HORAS=72

# "Olvidé mi contraseña": minutos que dura el código (llega por SMS o por correo)
RECUPERACION_MINUTOS=15

# Correo saliente (SMTP). Con MAIL_ENABLED=false no se envía nada: el correo solo queda en el log.
# Puerto 465 = TLS directo; 587 = STARTTLS. Con Gmail, SMTP_PASSWORD es una contraseña de aplicación.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=RESCATE360

# Super admin inicial (docker compose exec api python -m scripts.seed.crear_super_admin)
SUPER_ADMIN_NOMBRE=Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
