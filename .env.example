# Copiar a .env y completar. Nunca subir .env al repositorio.

# App
APP_ENV=local
APP_PORT=8000

# Base de datos (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://usuario:password@localhost:5432/rescate360

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MIN=30
JWT_REFRESH_EXPIRES_DAYS=7

# Servicio de IA (clasificación de prioridad)
IA_API_KEY=

# Firebase (notificaciones push)
FIREBASE_CREDENTIALS_PATH=

# Twilio (SMS de respaldo)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Almacenamiento de fotos
STORAGE_BUCKET=

# Retención de datos (días)
RETENCION_FOTOS_DIAS=90
RETENCION_UBICACIONES_DIAS=30
